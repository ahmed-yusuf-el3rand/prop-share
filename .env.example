# ==================================

# PropShare Frontend Environment

# ==================================

# Backend API base URL
VITE_API_URL=backend_api_base_url
# Google OAuth client ID (frontend only)
VITE_GOOGLE_CLIENT_ID=Google_OAuth_client_id
## Optional: API request timeout in milliseconds
VITE_API_TIMEOUT=timeout_in_milliseconds
# Token key for authentication
VITE_TOKEN_KEY=access_token
# Stripe publishable key (frontend only)
VITE_STRIPE_PUBLISHABLE_KEY=stripe_publishable_key